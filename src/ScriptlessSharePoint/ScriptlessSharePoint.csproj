<Project Sdk="Microsoft.NET.Sdk">

  <!-- Scriptless SharePoint: the Windows app. WinUI 3 (Windows App SDK,
       self-contained), laid out as Windows Settings is, with Core behind it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <AssemblyName>ScriptlessSharePoint</AssemblyName>
    <RootNamespace>ScriptlessSharePoint.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- package/build.ps1 makes the MSIX from its own manifest: the project
         itself builds an unpackaged app that carries the Windows App SDK.
         The MSIX tooling stays on: it makes the app's .pri and puts it, and
         the compiled XAML, in the publish folder -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The component packages, as File Size has them: the metapackage would
         also bring the AI and ML runtimes -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScriptlessSharePoint.Core\ScriptlessSharePoint.Core.csproj" />
  </ItemGroup>

</Project>
