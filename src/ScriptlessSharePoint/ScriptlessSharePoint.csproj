<Project Sdk="Microsoft.NET.Sdk">

  <!-- Scriptless SharePoint: the Windows app. A WPF window hosting the web UI
       (web/, React and Fluent UI) in WebView2, with Core behind it (AppBridge). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>ScriptlessSharePoint</AssemblyName>
    <RootNamespace>ScriptlessSharePoint.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ThemeMode (the Fluent theme, for the window frame) is marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <WebDir>$(MSBuildThisFileDirectory)..\..\web\</WebDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScriptlessSharePoint.Core\ScriptlessSharePoint.Core.csproj" />
  </ItemGroup>

  <!-- The web UI's build (web/dist) goes to web\ next to the exe. It's built
       here when it hasn't been yet; package/build.ps1 always builds it afresh,
       and `yarn dev` in web/ serves it live (see MainWindow, SSP_WEB_URL). -->
  <Target Name="IncludeWebUi" BeforeTargets="AssignTargetPaths" Condition="'$(SkipWebUi)' != 'true'">
    <Exec Condition="!Exists('$(WebDir)node_modules')" Command="yarn install --frozen-lockfile --non-interactive" WorkingDirectory="$(WebDir)" />
    <Exec Condition="!Exists('$(WebDir)dist\index.html')" Command="yarn build" WorkingDirectory="$(WebDir)" />
    <ItemGroup>
      <_WebUi Include="$(WebDir)dist\**\*" />
      <Content Include="@(_WebUi)" Link="web\%(_WebUi.RecursiveDir)%(_WebUi.Filename)%(_WebUi.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
