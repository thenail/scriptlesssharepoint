<?xml version="1.0" encoding="utf-8"?>
<!--
    File Size's layout: the title and the search in the title bar, the
    connections down the left as Settings has its categories, and the page
    beside them. On a connection's page: who it's signed in as, the table of
    site collections (opened in place, down to folders, files and items),
    and beside it the pane that acts on what's ticked.
-->
<Window
    x:Class="ScriptlessSharePoint.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScriptlessSharePoint.App"
    Title="Scriptless SharePoint">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Scriptless SharePoint" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/logo.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="SearchBox"
                                QueryIcon="Find"
                                PlaceholderText="Search site collections by title or address"
                                MinWidth="300"
                                MaxWidth="640"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                TextChanged="OnSearchChanged"
                                QuerySubmitted="OnSearchSubmitted" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="True"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="300"
                        SelectionChanged="OnNavSelectionChanged"
                        ItemInvoked="OnNavItemInvoked">
            <!-- Where Settings has the account: who the connection is signed in as -->
            <NavigationView.PaneHeader>
                <Grid Padding="16,4,16,20" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture x:Name="AccountPicture" Width="56" Height="56" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountName" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="Not signed in" />
                        <TextBlock x:Name="AccountDetail" Style="{StaticResource CaptionSecondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="PlansItem" Content="Plans" Tag="plans">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="HistoryItem" Content="Jobs" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AddConnectionItem" Content="Add a connection" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <!-- ================= no connections yet ================= -->
                <StackPanel x:Name="WelcomePage" Visibility="Collapsed" MaxWidth="520" Spacing="14"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/logo.png" Width="88" Height="88" />
                    <TextBlock Text="Welcome to Scriptless SharePoint" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Everything the SharePoint Online Management Shell does with sites, lists, libraries and files, without PowerShell. Start with a connection to your tenant." />
                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnAddConnection" Padding="20,8,20,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add a connection" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource CaptionSecondary}" TextAlignment="Center"
                               Text="Sign in with your Windows account, another account, an app with a certificate, or an access token." />
                </StackPanel>

                <!-- ================= a connection ================= -->
                <Grid x:Name="TenantPage" Padding="36,0,36,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        Where you are: the connection, then the selection on show
                        (picking the connection goes back to every site collection);
                        under it the tenant, how it's signed in, and what the table
                        shows. The tools for the table on the right.
                    -->
                    <Grid Margin="0,0,0,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <BreadcrumbBar x:Name="Crumbs" ItemClicked="OnCrumbClicked" Margin="0,0,0,2">
                                <BreadcrumbBar.Resources>
                                    <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
                                    <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
                                    <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                                    <Thickness x:Key="BreadcrumbBarChevronPadding">10,8,10,0</Thickness>
                                </BreadcrumbBar.Resources>
                            </BreadcrumbBar>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <HyperlinkButton x:Name="TenantLink" Padding="0" FontSize="12" Click="OnTenantLink" ToolTipService.ToolTip="Open the tenant in the browser" />
                                <TextBlock Text="·" Style="{StaticResource CaptionSecondary}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TenantDetail" Style="{StaticResource CaptionSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" />
                                <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" MaxWidth="320" HorizontalAlignment="Left" Width="320" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" Margin="0,6,0,0">
                            <Button x:Name="CollapseButton" Style="{StaticResource ToolButton}" Click="OnCollapseAll" ToolTipService.ToolTip="Close every open row" AutomationProperties.Name="Close every open row">
                                <FontIcon Glyph="&#xE70E;" FontSize="16" />
                            </Button>
                            <Button x:Name="RefreshButton" Style="{StaticResource ToolButton}" Click="OnRefresh" ToolTipService.ToolTip="Load the site collections again (F5)" AutomationProperties.Name="Load the site collections again (F5)">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            </Button>
                            <ToggleButton x:Name="PaneToggle" Style="{StaticResource ToolToggle}" IsChecked="True" Margin="4,0,0,0"
                                          Click="OnPaneToggle" ToolTipService.ToolTip="Show or hide the commands for what's ticked" AutomationProperties.Name="Show or hide the commands for what's ticked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE762;" FontSize="16" />
                                    <InfoBadge x:Name="SelectionBadge" Visibility="Collapsed" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error" IsOpen="False" Margin="0,0,0,12">
                        <InfoBar.ActionButton>
                            <Button x:Name="ErrorSignIn" Content="Sign in" Click="OnSignIn" Visibility="Collapsed" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- The table and, beside it, what to do with what's ticked -->
                    <Grid Grid.Row="2" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="PaneColumn" Width="380" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Padding="4,4,4,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="-4,0,-4,0" Padding="4,0,4,0" Height="34">
                                    <Grid Margin="4,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="220" />
                                            <ColumnDefinition Width="{x:Bind local:Columns.Current.Type, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:Columns.Current.Items, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:Columns.Current.Size, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind local:Columns.Current.Modified, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Name" Style="{StaticResource ColumnHeader}" Margin="62,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource ColumnHeader}" />
                                        <TextBlock Grid.Column="2" Text="Items" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="Size" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="Modified" Style="{StaticResource ColumnHeader}" />
                                    </Grid>
                                </Border>

                                <ListView x:Name="Table"
                                          Grid.Row="1"
                                          SelectionMode="None"
                                          CanDragItems="True"
                                          DragItemsStarting="OnRowsDragStarting"
                                          DragItemsCompleted="OnRowsDragCompleted"
                                          ContextRequested="OnRowContextRequested"
                                          PreviewKeyDown="OnTableKeyDown"
                                          ItemContainerStyle="{StaticResource TableRow}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:Row">
                                            <Grid Height="34" Background="Transparent" DoubleTapped="{x:Bind OnDoubleTapped}" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind ToolTip, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="220" />
                                                    <ColumnDefinition Width="{x:Bind local:Columns.Current.Type, Mode=OneWay}" />
                                                    <ColumnDefinition Width="{x:Bind local:Columns.Current.Items, Mode=OneWay}" />
                                                    <ColumnDefinition Width="{x:Bind local:Columns.Current.Size, Mode=OneWay}" />
                                                    <ColumnDefinition Width="{x:Bind local:Columns.Current.Modified, Mode=OneWay}" />
                                                </Grid.ColumnDefinitions>

                                                <!-- name: indent, chevron, tick, icon, title -->
                                                <StackPanel Orientation="Horizontal" Margin="{x:Bind Indent}" Spacing="2" Visibility="{x:Bind IsNode}">
                                                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource Chevron}" Click="{x:Bind OnChevron}" AutomationProperties.Name="{x:Bind OpenName, Mode=OneWay}" Visibility="{x:Bind ShowChevron, Mode=OneWay}" Opacity="{x:Bind ChevronOpacity}" IsTabStop="False">
                                                            <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="10" />
                                                        </Button>
                                                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind IsLoading, Mode=OneWay}" Visibility="{x:Bind IsLoading, Mode=OneWay}" />
                                                    </Grid>
                                                    <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" AutomationProperties.Name="{x:Bind TickName, Mode=OneWay}" MinWidth="0" Width="32" Padding="0" VerticalAlignment="Center" />
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- a note under an open row: empty, an error, loading -->
                                                <TextBlock Grid.ColumnSpan="5" Margin="{x:Bind Indent}" Padding="60,0,8,0" VerticalAlignment="Center"
                                                           Text="{x:Bind Message, Mode=OneWay}" Visibility="{x:Bind IsMessage}" FontStyle="Italic"
                                                           Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />

                                                <!-- the next page of a long list -->
                                                <HyperlinkButton Grid.ColumnSpan="5" Margin="{x:Bind Indent}" Padding="60,0,8,0" VerticalAlignment="Center"
                                                                 Content="{x:Bind Message, Mode=OneWay}" Visibility="{x:Bind IsMore}" Click="{x:Bind OnMore}" />

                                                <TextBlock Grid.Column="1" Text="{x:Bind TypeText, Mode=OneWay}" Style="{StaticResource TextCell}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind ItemsText, Mode=OneWay}" Style="{StaticResource NumberCell}" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource NumberCell}" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind ModifiedText, Mode=OneWay}" Style="{StaticResource TextCell}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- No rows: signing in, loading, nothing found -->
                                <StackPanel x:Name="EmptyState" Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <ProgressRing x:Name="EmptyRing" Width="32" Height="32" IsActive="False" />
                                    <TextBlock x:Name="EmptyText" MaxWidth="420" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" />
                                    <Button x:Name="SignInButton" HorizontalAlignment="Center" MinWidth="120" Content="Sign in" Style="{StaticResource AccentButtonStyle}"
                                            Click="OnSignIn" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ================= the pane ================= -->
                        <Border x:Name="Pane" Grid.Column="1" Style="{StaticResource Card}">
                            <Grid>
                                <!-- what's ticked, and the commands for it -->
                                <Grid x:Name="OverviewView" RowSpacing="8" Padding="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="16,0,8,0" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Selected" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="SelectedSummary" Style="{StaticResource CaptionSecondary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <HyperlinkButton x:Name="UndoButton" Content="Undo" Padding="6,4,6,4" Click="OnUndoTicks" Visibility="Collapsed" />
                                            <HyperlinkButton x:Name="ClearButton" Content="Clear" Padding="6,4,6,4" Click="OnClearSelection" Visibility="Collapsed"
                                                             ToolTipService.ToolTip="Untick everything (Undo ticks it again)" />
                                        </StackPanel>
                                        <SplitButton x:Name="SaveSelectionButton" Grid.Column="2" Background="Transparent" BorderBrush="Transparent"
                                                     Height="32" Padding="8,0,8,0" Click="OnSaveSelection" VerticalAlignment="Center"
                                                     Visibility="Collapsed" ToolTipService.ToolTip="Save the selection (Ctrl+S)" AutomationProperties.Name="Save the selection">
                                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                            <SplitButton.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem Text="Save as a new selection…" KeyboardAcceleratorTextOverride="Ctrl+Shift+S" Click="OnSaveSelectionAsNew">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE792;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </SplitButton.Flyout>
                                        </SplitButton>
                                        <Button Grid.Column="3" Style="{StaticResource ToolButton}" Width="32" Click="OnHidePane" ToolTipService.ToolTip="Hide the pane" AutomationProperties.Name="Hide the pane">
                                            <FontIcon Glyph="&#xE89F;" FontSize="14" />
                                        </Button>
                                    </Grid>

                                    <!-- what's ticked, in short; opens to the full list -->
                                    <Expander x:Name="SelectedExpander" Grid.Row="1" Margin="12,0,12,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Padding="0" Visibility="Collapsed">
                                        <Expander.Header>
                                            <TextBlock x:Name="SelectedExpanderHeader" TextTrimming="CharacterEllipsis" />
                                        </Expander.Header>
                                        <ListView x:Name="SelectedList" SelectionMode="None" MaxHeight="220" ItemContainerStyle="{StaticResource TableRow}" />
                                    </Expander>

                                    <StackPanel Grid.Row="2" Padding="16,0,16,0" Spacing="8">
                                        <TextBlock x:Name="NothingSelected" Style="{StaticResource CaptionSecondary}"
                                                   Text="Tick site collections, lists, libraries, folders, files or items in the table to act on them (Space ticks the row you're on; right-click for more). Until then, these commands are for the whole tenant." />
                                        <!-- which of what's ticked the commands are for: a tab per kind, then the tenant -->
                                        <ScrollViewer x:Name="KindScroller" Margin="-12,0,-12,0" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                            <SelectorBar x:Name="KindBar" SelectionChanged="OnKindChanged" />
                                        </ScrollViewer>
                                        <AutoSuggestBox x:Name="CommandFilter" PlaceholderText="Find a command" QueryIcon="Filter" TextChanged="OnCommandFilterChanged" />
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="3" Padding="4,0,4,8">
                                        <StackPanel x:Name="CommandList" Padding="0,0,8,0" />
                                    </ScrollViewer>
                                </Grid>

                                <!-- one command: its inputs, then Run -->
                                <Grid x:Name="FormView" Visibility="Collapsed" RowSpacing="8" Padding="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="8,0,16,0" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource ToolButton}" Click="OnBackToCommands" ToolTipService.ToolTip="Back to the commands" AutomationProperties.Name="Back to the commands">
                                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                        </Button>
                                        <TextBlock x:Name="FormTitle" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
                                        <StackPanel Spacing="12" Padding="0,0,0,12">
                                            <TextBlock x:Name="FormDescription" TextWrapping="Wrap" />
                                            <TextBlock x:Name="FormPowerShell" Style="{StaticResource CaptionSecondary}" IsTextSelectionEnabled="True" />
                                            <InfoBar x:Name="FormNote" IsOpen="False" IsClosable="False" Severity="Informational" />
                                            <StackPanel x:Name="FormFields" Spacing="14" />
                                            <TextBlock x:Name="FormProblems" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FormTargets" Style="{StaticResource CaptionSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <DropDownButton x:Name="AddToPlanButton" Content="Add to plan" ToolTipService.ToolTip="Keep this command, with these inputs, as a step of a plan">
                                                    <DropDownButton.Flyout>
                                                        <MenuFlyout x:Name="AddToPlanMenu" Placement="TopEdgeAlignedRight" Opening="OnAddToPlanOpening" />
                                                    </DropDownButton.Flyout>
                                                </DropDownButton>
                                                <Button x:Name="RunButton" Style="{StaticResource AccentButtonStyle}" MinWidth="96" Click="OnRun" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- a plan: what it runs on and its steps -->
                                <Grid x:Name="PlanView" Visibility="Collapsed" RowSpacing="8" Padding="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="8,0,16,0" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource ToolButton}" Click="OnClosePlan" ToolTipService.ToolTip="Back to the commands" AutomationProperties.Name="Back to the commands">
                                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                        </Button>
                                        <TextBlock x:Name="PlanTitle" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
                                        <StackPanel Spacing="10" Padding="0,0,0,12">
                                            <TextBlock x:Name="PlanDescription" TextWrapping="Wrap" />
                                            <TextBlock x:Name="PlanMeta" Style="{StaticResource CaptionSecondary}" TextWrapping="Wrap" />
                                            <InfoBar x:Name="PlanProblems" IsOpen="False" IsClosable="False" Severity="Warning" Title="This plan can't run as it is" />
                                            <TextBlock Text="Runs on" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                                            <TextBlock x:Name="PlanRunsOn" TextWrapping="Wrap" />
                                            <StackPanel x:Name="PlanSelectionActions" Spacing="4" />
                                            <StackPanel x:Name="PlanInputs" Spacing="10" />
                                            <InfoBar x:Name="PlanRunCheck" IsOpen="False" IsClosable="False" Severity="Warning" Title="Before it can run" />
                                            <TextBlock Text="Steps" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                                            <StackPanel x:Name="PlanSteps" Spacing="6" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Delete" Click="OnDeletePlan" ToolTipService.ToolTip="Delete the plan (nothing in SharePoint changes)" />
                                            <Button x:Name="RunPlanButton" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" MinWidth="96" Content="Run plan" Click="OnRunPlan" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- a run: how far it's got, and how each target went -->
                                <Grid x:Name="ResultsView" Visibility="Collapsed" RowSpacing="8" Padding="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Padding="16,0,16,0" Spacing="6">
                                        <TextBlock x:Name="ResultsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ResultsInputs" Style="{StaticResource CaptionSecondary}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                                        <TextBlock x:Name="ResultsSummary" Style="{StaticResource CaptionSecondary}" />
                                        <ProgressBar x:Name="ResultsBar" />
                                    </StackPanel>
                                    <ListView x:Name="ResultsList" Grid.Row="1" SelectionMode="None" Padding="4,0,4,0" />
                                    <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button x:Name="CopyResultsButton" Content="Copy" Click="OnCopyResults" ToolTipService.ToolTip="Copy the results as text" AutomationProperties.Name="Copy the results as text" />
                                            <Button x:Name="SelectFailedButton" Content="Tick the failed ones" Click="OnSelectFailed" Visibility="Collapsed" />
                                            <Button x:Name="CancelRunButton" Content="Cancel" Click="OnCancelRun" />
                                            <Button x:Name="PauseRunButton" Click="OnPauseRun" MinWidth="80" />
                                            <Button x:Name="RunAllButton" Content="Run all" Click="OnRunAll" Visibility="Collapsed"
                                                    ToolTipService.ToolTip="Run it on every one still waiting to be confirmed" />
                                            <Button x:Name="DoneButton" Content="Done" Style="{StaticResource AccentButtonStyle}" Click="OnResultsDone" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= Jobs ================= -->
                <Grid x:Name="JobsPage" Padding="36,0,36,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Jobs" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource CaptionSecondary}" TextWrapping="Wrap"
                                       Text="Commands and plans running now, and the last 500 that ran, kept on this PC. Pause, carry on or cancel those running; ones running when the app closed come back paused." />
                        </StackPanel>
                        <Button x:Name="ClearHistoryButton" Grid.Column="1" Content="Clear finished jobs" Click="OnClearHistory" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <ListView x:Name="HistoryList" SelectionMode="Single" Padding="4" SelectionChanged="OnHistoryPicked" />
                                <TextBlock x:Name="HistoryEmpty" Style="{StaticResource CaptionSecondary}" TextWrapping="Wrap" Margin="20" Visibility="Collapsed"
                                           Text="Nothing yet. Commands and plans you run show up here, with how each target went." />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <Grid x:Name="RunDetail" RowSpacing="8" Padding="0,16,0,0" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Padding="20,0,20,4" Spacing="4">
                                    <TextBlock x:Name="RunTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RunWhen" Style="{StaticResource CaptionSecondary}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RunInputs" Style="{StaticResource CaptionSecondary}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,6,0,0" />
                                    <TextBlock x:Name="RunSummaryText" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="JobBar" Visibility="Collapsed" Margin="0,4,0,0" />
                                </StackPanel>
                                <ListView x:Name="RunTargets" Grid.Row="1" SelectionMode="None" Padding="8,0,8,0" />
                                <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Copy" Click="OnCopyRun" ToolTipService.ToolTip="Copy the job as text" />
                                            <Button x:Name="DeleteRunButton" Content="Delete" Click="OnDeleteRun" ToolTipService.ToolTip="Remove this job from the list" />
                                        </StackPanel>
                                        <!-- a finished job -->
                                        <StackPanel x:Name="FinishedJobActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button x:Name="TickRunFailedButton" Content="Tick the failed ones" Click="OnTickRunFailed" />
                                            <Button x:Name="TickRunButton" Content="Tick these" Click="OnTickRun"
                                                    ToolTipService.ToolTip="Show its targets ticked in the connection's table" />
                                            <Button x:Name="RunAgainButton" Content="Run again…" Style="{StaticResource AccentButtonStyle}" Click="OnRunAgain" />
                                        </StackPanel>
                                        <!-- a job running or paused -->
                                        <StackPanel x:Name="LiveJobActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Visibility="Collapsed">
                                            <Button x:Name="JobRunAllButton" Content="Run all" Click="OnJobRunAll" Visibility="Collapsed"
                                                    ToolTipService.ToolTip="Run it on every one still waiting to be confirmed" />
                                            <Button x:Name="JobCancelButton" Content="Cancel" Click="OnJobCancel" />
                                            <Button x:Name="JobPauseButton" Style="{StaticResource AccentButtonStyle}" MinWidth="96" Click="OnJobPause" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= Plans ================= -->
                <Grid x:Name="PlansPage" Padding="36,0,36,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Plans" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource CaptionSecondary}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                                       Text="Steps that run in order on what's ticked. Open one to run it, pick what it runs on, or change its steps. Plans that fit what's ticked are also listed first in the pane, beside the commands. AI apps make them too: they show up here as soon as they're saved." />
                        </StackPanel>
                        <Button x:Name="NewPlanButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnNewPlan" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="New plan" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="1000" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="PlanCards" Spacing="4" Padding="0,0,0,12" />
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ================= Settings ================= -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <StackPanel Padding="36,0,36,28" MaxWidth="1000" HorizontalAlignment="Left" MinWidth="560">
                        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />

                        <TextBlock Text="Commands" Style="{StaticResource GroupHeader}" />
                        <Border Style="{StaticResource Card}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,14,16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Confirm every change" />
                                    <TextBlock Style="{StaticResource CaptionSecondary}" TextWrapping="Wrap"
                                               Text="Commands that change SharePoint ask about each item before running on it: Run or Skip, one by one, or Run all. When this is off, commands that delete, or run on many items, still ask once first." />
                                </StackPanel>
                                <ToggleSwitch x:Name="ConfirmChangesSwitch" Grid.Column="1" OnContent="On" OffContent="Off" MinWidth="0"
                                              VerticalAlignment="Center" Toggled="OnConfirmChangesToggled"
                                              AutomationProperties.Name="Confirm every change" />
                            </Grid>
                        </Border>

                        <TextBlock Text="AI apps" Style="{StaticResource GroupHeader}" />
                        <TextBlock Style="{StaticResource CaptionSecondary}" Margin="1,0,0,10"
                                   Text="Scriptless SharePoint comes with an MCP server, so AI apps on this PC can search your sites and manage site collection app catalogs with the connections set up here. Sign-ins and secrets stay in the app." />
                        <StackPanel x:Name="AiSnippets" Spacing="4" />

                        <TextBlock Text="About" Style="{StaticResource GroupHeader}" />
                        <Border Style="{StaticResource Card}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,14,16,14" Margin="0,0,0,4">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Connections, sign-ins and logs" />
                                    <TextBlock x:Name="DataFolderText" Style="{StaticResource CaptionSecondary}" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open folder" Click="OnOpenDataFolder" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,14,16,14">
                            <StackPanel>
                                <TextBlock Text="Privacy" />
                                <TextBlock Style="{StaticResource CaptionSecondary}"
                                           Text="Scriptless SharePoint talks only to Microsoft's sign-in and your SharePoint tenant. It has no analytics and no tracking. Tokens stay in Windows' encrypted token cache, on this PC." />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="VersionText" Margin="1,28,0,0" IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- Short confirmations (e.g. items added to a saved selection), over the page -->
        <InfoBar x:Name="Toast" Grid.Row="1" Severity="Success" IsOpen="False" IsClosable="True"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" MinWidth="360" MaxWidth="620">
            <InfoBar.ActionButton>
                <Button x:Name="ToastAction" Click="OnToastAction" Visibility="Collapsed" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>
