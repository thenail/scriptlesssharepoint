<?xml version="1.0" encoding="utf-8"?>
<!-- A connection to a tenant: where, and how it signs in. Test signs in without saving. -->
<ContentDialog
    x:Class="ScriptlessSharePoint.App.ConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    PrimaryButtonText="Save"
    SecondaryButtonText="Test connection"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">820</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="600" Padding="0,0,16,0">
        <StackPanel Spacing="14" Width="560">
            <TextBox x:Name="TenantBox" Header="SharePoint tenant" IsSpellCheckEnabled="False"
                     Description="The tenant's name or any SharePoint address in it, e.g. contoso or https://contoso.sharepoint.com."
                     LostFocus="OnTenantLostFocus" />
            <TextBox x:Name="NameBox" Header="Name" />

            <RadioButtons x:Name="ModeButtons" Header="Sign in with" SelectionChanged="OnModeChanged">
                <x:String>The account signed in to Windows</x:String>
                <x:String>Another account (choose it when signing in)</x:String>
                <x:String>An app with a certificate (app-only, no user)</x:String>
                <x:String>An access token</x:String>
            </RadioButtons>

            <StackPanel x:Name="UserPanel" Spacing="12">
                <TextBox x:Name="UserClientIdBox" Header="App (client) ID" FontFamily="Cascadia Mono, Consolas" IsSpellCheckEnabled="False" />
                <TextBox x:Name="UserTenantBox" Header="Tenant ID or domain" IsSpellCheckEnabled="False"
                         Description="Only for single-tenant app registrations, e.g. contoso.onmicrosoft.com." />
                <CheckBox x:Name="BrowserCheck" Content="Sign in in the browser instead of with Windows" />
                <TextBlock x:Name="AccountText" Style="{StaticResource CaptionSecondary}" />
                <TextBlock Style="{StaticResource CaptionSecondary}"
                           Text="The app registration needs, under Authentication › Mobile and desktop applications, the redirect URI ms-appx-web://microsoft.aad.brokerplugin/&lt;client ID&gt; (Windows sign-in) or http://localhost (browser sign-in), and under API permissions SharePoint › Delegated › AllSites.FullControl, with admin consent. Tenant-wide commands also need a SharePoint administrator." />
            </StackPanel>

            <StackPanel x:Name="CertPanel" Spacing="12">
                <TextBox x:Name="CertClientIdBox" Header="App (client) ID" FontFamily="Cascadia Mono, Consolas" IsSpellCheckEnabled="False" PlaceholderText="00000000-0000-0000-0000-000000000000" />
                <TextBox x:Name="CertTenantBox" Header="Tenant ID or domain" IsSpellCheckEnabled="False" Description="e.g. contoso.onmicrosoft.com or the tenant's GUID." />
                <TextBox x:Name="ThumbprintBox" Header="Certificate thumbprint" FontFamily="Cascadia Mono, Consolas" IsSpellCheckEnabled="False" TextChanged="OnThumbprintChanged" />
                <TextBlock x:Name="ThumbprintInfo" Style="{StaticResource CaptionSecondary}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnImportPfx">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                            <TextBlock Text="Import .pfx…" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnCreateCertificate">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB95;" FontSize="14" />
                            <TextBlock Text="Create a certificate…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid x:Name="PfxPanel" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PfxPassword" Header="The certificate file's password" PlaceholderText="Empty if it has none" />
                    <Button Grid.Column="1" Content="Import" VerticalAlignment="Bottom" Click="OnFinishImport" />
                </Grid>
                <TextBlock Style="{StaticResource CaptionSecondary}"
                           Text="The app registration needs, under API permissions, SharePoint › Application › Sites.FullControl.All with admin consent, and this certificate's .cer under Certificates &amp; secrets. SharePoint doesn't accept client secrets for app-only access, only certificates." />
            </StackPanel>

            <StackPanel x:Name="TokenPanel" Spacing="12">
                <TextBox x:Name="TokenBox" Header="Access token" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                         FontFamily="Cascadia Mono, Consolas" IsSpellCheckEnabled="False" TextChanged="OnTokenChanged" />
                <TextBlock x:Name="TokenInfo" Style="{StaticResource CaptionSecondary}" />
                <TextBlock Style="{StaticResource CaptionSecondary}"
                           Text="A token for https://&lt;tenant&gt;.sharepoint.com (not Microsoft Graph). Tokens can't be refreshed and last about an hour. It's kept encrypted for your Windows account." />
            </StackPanel>

            <Expander x:Name="AdvancedExpander" Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <TextBox x:Name="AdminUrlBox" Header="Admin centre address" IsSpellCheckEnabled="False"
                         Description="Leave it empty for https://&lt;tenant&gt;-admin.sharepoint.com." />
            </Expander>

            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
