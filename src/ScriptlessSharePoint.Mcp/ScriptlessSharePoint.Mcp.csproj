<Project Sdk="Microsoft.NET.Sdk">

  <!-- scriptless-sharepoint-mcp: the local MCP server on stdio. AI apps start it
       themselves (Claude Desktop, Claude Code, VS Code, Windows' agent registry);
       in the Store package it's an app execution alias. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>scriptless-sharepoint-mcp</AssemblyName>
    <RootNamespace>ScriptlessSharePoint.Mcp</RootNamespace>
    <ApplicationIcon>..\ScriptlessSharePoint\Assets\app.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScriptlessSharePoint.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScriptlessSharePoint.Core\ScriptlessSharePoint.Core.csproj" />
  </ItemGroup>

</Project>
